{
  "name": "@workspace/chalet-marketplace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:preview-transform": "node scripts/check-preview-transform.mjs",
    "test:preview-transform": "node --test scripts/check-preview-transform.test.mjs && tsc -p scripts/fixtures/preview-transform/tsconfig.json",
    "test:city-search": "tsx --test src/lib/city-name.test.ts",
    "test:inventory-filters": "tsx --test src/lib/inventory-filters.test.ts",
    "test:route-loading": "tsx --test src/lib/route-import-retry.test.ts",
    "test": "NODE_ENV=production tsx --test src/lib/serviceReceipt.test.ts",
    "check:playwright-image-version": "node scripts/check-playwright-image-version.mjs",
    "test:e2e": "playwright test",
    "test:owner-navigation": "tsx --test src/lib/owner-service-navigation.test.ts src/lib/owner-module-boundaries.test.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e:owner-empty": "playwright test e2e/owner-empty-state.spec.ts --project=owner-onboarding",
    "test:e2e:connection": "playwright test e2e/connection-recovery.spec.ts --project=connection-desktop --project=connection-mobile",
    "test:e2e:iphone-calendar": "playwright test e2e/dual-calendar-iphone.spec.ts --project=webkit-iphone"
  },
