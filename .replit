modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "preview-transform"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "preview-transform-detector"

[[workflows.workflow]]
name = "preview-transform"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/chalet-marketplace run check:preview-transform"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "preview-transform-detector"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/chalet-marketplace run test:preview-transform"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"
packages = ["mariadb_1011"]

[userenv]

[userenv.shared]
MOYASAR_PUBLISHABLE_KEY = "pk_test_vcFUHJDBwiyRypcFChTLtgpI4skLeU6R6Tez5SrF"
MOYASAR_SECRET_KEY_PLACEHOLDER = "sk_test_vcFUHJDBwiyRypcFChTLtgpI4skLeU6R6Tez5SrF"
DISABLE_STARTUP_SEEDING = "true"
