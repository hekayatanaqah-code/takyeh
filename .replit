modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MOYASAR_PUBLISHABLE_KEY = "pk_test_vcFUHJDBwiyRypcFChTLtgpI4skLeU6R6Tez5SrF"
MOYASAR_SECRET_KEY_PLACEHOLDER = "sk_test_vcFUHJDBwiyRypcFChTLtgpI4skLeU6R6Tez5SrF"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 22125
externalPort = 3000
